@model IReadOnlyList<Commerce.Api.Dtos.CustomerResponse>
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Clienti</h1><a asp-action="Create" class="btn btn-primary">Nuovo cliente</a></div>
<table class="table table-striped"><thead><tr><th>Nome</th><th>Email</th><th>Telefono</th><th></th></tr></thead><tbody>
@foreach (var customer in Model) { <tr><td>@customer.Name</td><td>@customer.Email</td><td>@customer.Phone</td><td class="text-end"><a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary">Modifica</a><form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Elimina</button></form></td></tr> }
</tbody></table>
